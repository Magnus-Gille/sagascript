{"send":{"v":1,"id":1,"op":"warm"}}
{"expect":{"id":1,"ok":false,"error":{"code":"protocol","message":"<string>","retryable":false}}}
{"send":{"v":1,"id":2,"op":"hello","client":{"name":"sagascript","version":"1.4.4","git_sha":"0123456789abcdef0123456789abcdef01234567"}}}
