{
  "identifier": "default",
  "description": "Sagascript default capabilities",
  "windows": ["*"],
  "permissions": [
    "core:default",
    "autostart:default",
    "dialog:default",
    "dialog:allow-open",
    "core:event:allow-listen",
    "core:webview:allow-webview-position",
    "core:window:default",
    "core:window:allow-hide"
  ]
}
