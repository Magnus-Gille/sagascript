  "state-changed": {
    "consumer": "gui",
    "samples": [
      "idle",
      "recording",
      "loading_model",
      "transcribing",
      "error",
      "settings_reloaded"
    ]
  },
  "transcription-phase": {
    "consumer": "internal",
    "reason": "legacy: only the legacy diarized transcribe_file path sends it; the GUI imports meetings through the meeting-job API",
    "samples": [
      "loading",
      "preparing",
      "encoding"
    ]
  },
  "transcription-progress": {
    "consumer": "internal",
    "reason": "legacy: training and the legacy diarized transcribe_file path still report it; plain imports use plain-transcription-progress and meetings are polled",
    "samples": [
      1,
      42
    ]
  },
  "transcription-result": {
    "consumer": "gui",
    "samples": [
      "Hej, det här är en diktering."
    ]
  },
  "update-aborted": {
    "consumer": "gui",
