{
  "name": "sagascript",
  "private": true,
  "version": "1.4.6",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build-frontend.mjs",
    "test:unit": "vitest run",
    "test:unit:coverage": "vitest run --coverage",
    "test:frontend": "node scripts/run-frontend-tests.mjs",
    "test:ui": "node scripts/run-frontend-tests.mjs --group ui",
    "test:ci": "node scripts/run-frontend-tests.mjs --group ci",
    "test:release": "node scripts/run-frontend-tests.mjs --group release",
    "test:code-health": "node --test scripts/test-code-health-producer.mjs scripts/test-code-health-workflow.mjs && node tests/scripts/test-code-health-contract-provenance.mjs && node tests/scripts/validate-code-health-objective.mjs && node tests/scripts/test-code-health-policy.mjs",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "release:check": "node scripts/check-release.mjs",
    "licenses:generate": "node scripts/generate-third-party-notices.mjs --write",
    "licenses:check": "node scripts/generate-third-party-notices.mjs --check",
    "tauri": "tauri",
    "test:browser": "node scripts/run-transcription-browser-tests.mjs",
    "verify": "node scripts/verify.mjs",
    "verify:fast": "node scripts/verify.mjs --fast"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tauri-apps/cli": "^2.12.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "^14.6.8",
    "@tsconfig/svelte": "^5.0.0",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-plugin-svelte": "^3.23.1",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.4",
    "playwright": "1.64.1",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "tslib": "^2.6.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.72.0",
    "vite": "^6.4.4",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-autostart": "^2.7.0",
    "@tauri-apps/plugin-dialog": "^2.8.3"
  }
}
